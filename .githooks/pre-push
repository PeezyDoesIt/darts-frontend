#!/bin/sh
#
# Refuse to push straight to main.
#
# main deploys, so anything landing on it should have had CI run against it first. Three of
# four consecutive red runs came from commits that skipped a PR: the coin flip moved to its
# own tile in two direct pushes, the home specs still asserted the old hero chip, and nothing
# caught it until a PR ran the suite afterwards.
#
# This is no longer the thing enforcing that. main is protected on GitHub — a pull request is
# required, `test` must pass, the branch must be current, and it applies to admins too, so
# nobody has a way around it. This hook was written when the repo was private on the free
# plan and protection could not be switched on at all; making it public is what changed that.
#
# `preview` is deliberately not a required check. It still runs on every pull request from
# this repo and still deploys a real preview to check routing against — it is the check that
# caught Wrangler dropping Node 20 — but it cannot run on a pull request from a fork, so
# requiring it would leave outside contributions permanently unmergeable, and it would make a
# Cloudflare outage a merge freeze. The cost of that choice is that a change which breaks
# `pages deploy` can now merge on a green `test`, and main's deploy job is where it surfaces.
# Production keeps serving the last good deployment when that happens, so the damage is a red
# main and a release that did not ship, not an outage. Read the preview job's result rather
# than waiting to be stopped by it.
#
# It is kept because it fails in the moment you type the command, with the commands to run
# next, rather than after a round trip to a rejection that explains less. Treat it as a
# convenience, not the guarantee: a clone without core.hooksPath set never runs it, and
# that clone is still protected.
#
# git reports one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>

while read -r local_ref local_sha remote_ref remote_sha
do
  case "$remote_ref" in
    refs/heads/main)
      echo ""
      echo "  pre-push: refusing to push straight to main."
      echo ""
      echo "  main deploys, and CI has to run against a change before it lands there."
      echo "  Put it on a branch and open a PR:"
      echo ""
      echo "      git switch -c my-change"
      echo "      git push -u origin my-change"
      echo "      gh pr create"
      echo ""
      echo "  Then let 'gh pr merge' land it — that merges server-side and is unaffected"
      echo "  by this hook."
      echo ""
      echo "  --no-verify skips this hook but will not get the push through: main is"
      echo "  protected on GitHub and the server rejects it too. A real emergency means"
      echo "  lifting that protection in the repository settings, deliberately."
      echo ""
      exit 1
      ;;
  esac
done

exit 0
