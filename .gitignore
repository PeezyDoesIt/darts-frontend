# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/dist
/node_modules
/platforms
/plugins
/www

# Playwright smoke-test output — traces and screenshots are per-run debugging artifacts
/test-results
/playwright-report
/blob-report
/playwright/.cache

# Environment files — commit .env.example only, never .env.local or secrets
.env
.env.*
.env.local
.env.*.local

# Handoff bundles are dropped in the repo root to be diffed against, not built — they are
# deliberately partial and often written from an older snapshot. Kept out of git so they
# cannot be swept into a commit by `git add .`, and out of eslint for the same reason.
handoff-*/
*.zip

# Build output captured for reading, not keeping.
build.txt
